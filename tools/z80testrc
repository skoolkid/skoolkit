require_env() {
  for v in $*; do
    if [[ -z ${!v} ]]; then
      echo "ERROR: $v is not set"
      exit 1
    fi
  done
}

require_dir() {
  require_env $*
  for v in $*; do
    VDIR=${!v}
    if [[ ! -d $VDIR ]]; then
      echo "ERROR: $VDIR: directory not found"
      exit 1
    fi
  done
}

wait_log() {
  message=$1
  pid=$2
  suffix=$3

  echo -n "${message}: "
  if wait $pid; then
    echo "OK $suffix"
    return 0
  fi
  echo -e "\e[0;31mFAILED $suffix\e[0m"
  return 1
}
