#!/usr/bin/env bash
set -e # Abort on errors

usage() {
  cat <<EOF
Usage: $(basename $0) deb|rpm

  Create a SkoolKit Debian or RPM package.
EOF
  exit 1
}

PKGTYPE=$1
[ "$PKGTYPE" = "deb" ] || [ "$PKGTYPE" = "rpm" ] || usage

if [ -z "$SKOOLKIT_HOME" ]; then
  echo "Error: SKOOLKIT_HOME not defined."
  exit 1
fi
if [ ! -d "$SKOOLKIT_HOME" ]; then
  echo "Error: directory not found: $SKOOLKIT_HOME"
  exit 1
fi

if [[ ! -f /etc/os-release ]]; then
  echo "Error: /etc/os-release not found: unable to determine distro"
  exit 1
fi
grep -q "^ID=fedora" /etc/os-release && fedora=1 || fedora=0

cd $SKOOLKIT_HOME
SKOOLKIT_VERSION=$(./skool2html.py -V 2>&1 | cut -f2 -d' ')
SKOOLKIT_TAR=skoolkit-${SKOOLKIT_VERSION}.tar.xz

if [ -f "dist/$SKOOLKIT_TAR" ]; then
  echo "Using existing $SKOOLKIT_TAR"
elif [[ $fedora -eq 1 ]]; then
  echo "Error: No pre-built dist/$SKOOLKIT_TAR found"
  exit 1
else
  echo "Building $SKOOLKIT_TAR"
  tools/mksktarball -q -t
fi

if [ "$PKGTYPE" = "deb" ]; then
  DEB_VERSION=$(dpkg-parsechangelog -l $SKOOLKIT_HOME/debian/changelog -S Version)
  cd dist
  tar xf $SKOOLKIT_TAR
  cd skoolkit-${SKOOLKIT_VERSION}
  cp -a $SKOOLKIT_HOME/debian .
  debuild -b -us -uc
  rm -rf ../skoolkit_${DEB_VERSION}*.build ../skoolkit_${DEB_VERSION}*.changes
  cd $SKOOLKIT_HOME
  echo "Created $(ls $SKOOLKIT_HOME/dist/skoolkit_${DEB_VERSION}_*.deb)"
elif [ "$PKGTYPE" = "rpm" ]; then
  if [[ $fedora -eq 1 ]]; then
    FEDORA_HOME=$HOME
    FEDORA_SK_HOME=$SKOOLKIT_HOME
  else
    FEDORA_HOME=$(ls -1vd ~/distrobox/fedora* | tail -1)
    CONTAINER=$(basename $FEDORA_HOME)
    echo "Using container $CONTAINER"
    FEDORA_SK_HOME=$FEDORA_HOME/projects/skoolkit
    rm -rf $FEDORA_SK_HOME
    mkdir -p $FEDORA_SK_HOME/dist
    rsync -aR $(git ls-files) $FEDORA_SK_HOME
  fi
  cp -p dist/$SKOOLKIT_TAR $FEDORA_HOME/rpmbuild/SOURCES/skoolkit-${SKOOLKIT_VERSION}.tar.xz
  rm -f $FEDORA_HOME/rpmbuild/RPMS/x86_64/skoolkit-${SKOOLKIT_VERSION}-*.rpm
  sed -i "s/^\(Version:[[:space:]]*\).*/\1${SKOOLKIT_VERSION}/" $FEDORA_SK_HOME/rpm/skoolkit.spec
  if [[ $fedora -eq 1 ]]; then
    rpmbuild -bb rpm/skoolkit.spec
  else
    distrobox enter $CONTAINER -- rpmbuild -bb $FEDORA_SK_HOME/rpm/skoolkit.spec
  fi
  mv $FEDORA_HOME/rpmbuild/RPMS/x86_64/skoolkit-${SKOOLKIT_VERSION}-*.rpm $SKOOLKIT_HOME/dist
  echo "Created $(ls $SKOOLKIT_HOME/dist/skoolkit-${SKOOLKIT_VERSION}-*.rpm)"
fi
