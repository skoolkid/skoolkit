#!/usr/bin/env bash

# Runs pasmo over groups of ASM files created by 'write-files' to check for
# differences in output.

PASMO=$(command -v pasmo)
if [[ -z "$PASMO" ]]; then
  echo "Error: 'pasmo' executable not found"
  exit 1
fi

. $(dirname $0)/ddiffs-functions

ERR_ON="\e[0;31m"
ERR_OFF="\e[0m"

check() {
  baseasm=$1.asm
  if [ ! -f $baseasm ]; then
    echo -e "${ERR_ON}ERROR: Base asm file $baseasm not found${ERR_OFF}" 1>&2
    return 1
  fi

  fails=""
  diffs=""
  for a in $*; do
    asmfile=$a.asm
    if [ ! -f $asmfile ]; then
      echo -e "${ERR_ON}ERROR: $asmfile not found${ERR_OFF}" 1>&2
      return 1
    fi
    binfile=$a.bin
    echo -n "Writing $binfile..."
    if $PASMO $asmfile $binfile &> /dev/null; then
      echo "done"
    else
      echo -e "${ERR_ON}FAILED${ERR_OFF}"
      fails="$fails $asmfile"
      rm -f $binfile
    fi
  done

  base=$1.bin
  [ -f $base ] || return 0 # Failure to assemble already recorded above
  shift
  for b in $*; do
    binfile=$b.bin
    [ -f $binfile ] || continue # Failure to assemble already recorded above
    echo -n "Comparing $binfile with $base..."
    if cmp -s $base $binfile; then
      echo "same"
    else
      echo -e "${ERR_ON}DIFFERENT${ERR_OFF}"
      diffs="$diffs $binfile"
    fi
  done

  return 0
}

usage() {
  echo "Usage: $(basename $0) $GAMES"
  echo ""
  echo "  Assembles all the ASM files for a disassembly and checks that the output is"
  echo "  identical where expected (e.g. between decimal and hexadecimal versions)."
  exit 1
}

###############################################################################
# Begin...
###############################################################################
game=$1
read_ddiffsrc $game

rc=0
for name in $game load save start; do
  if [[ $name == $game ]] || [[ -f "$name.asm" ]]; then
    for f in '' -f{1,2}; do
      if check $name{,-H,-D}{,-l,-u}$f{,-s}; then
        echo ""
        [ -n "$fails" ] && allfails="$allfails $fails"
        [ -n "$diffs" ] && alldiffs="$alldiffs\n  $base:$diffs"
      else
        rc=4
      fi
    done
  fi
done
for name in $game load save start; do
  if [[ $name == $game ]] || [[ -f "$name.asm" ]]; then
    for f in -f{1,2,3}; do
      if check $name{,-H,-D}{,-l,-u}$f-r; then
        echo ""
        [ -n "$fails" ] && allfails="$allfails $fails"
        [ -n "$diffs" ] && alldiffs="$alldiffs\n  $base:$diffs"
      else
        rc=4
      fi
    done
  fi
done

echo "------------------------------------ SUMMARY -----------------------------------"
((rc & 4)) && echo -e "${ERR_ON}There were missing files (see errors above)${ERR_OFF}"
if [ -n "$allfails" ]; then
  let rc+=1
  echo -e "${ERR_ON}Failed to assemble:"
  for f in $allfails; do
    echo "  $f"
  done
  echo -e "${ERR_OFF}"
else
  echo "Failed to assemble: None"
fi
if [ -n "$alldiffs" ]; then
  let rc+=2
  echo -e "${ERR_ON}Differences:$alldiffs${ERR_OFF}"
else
  echo "Differences: None"
fi
exit $rc
